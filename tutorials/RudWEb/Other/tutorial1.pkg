<refentry id="{@id}">
  <refnamediv>
    <refname>Simple Tutorial</refname>
    <refpurpose>The simplest Tutorial Possible</refpurpose>
  </refnamediv>
  <refsynopsisdiv>
    <author>
      Gregory Beaver
    <authorblurb>
      {@link mailto:cellog@php.net cellog@php.net}
    </authorblurb>
    </author>
  </refsynopsisdiv>
  <refsect1 id="{@id intro}">
    <refsect2 id="{@id mysubsection}">
      <para>Hello sub</para>
    </refsect2>
    <para>Hello World</para>
  </refsect1>
</refentry>