<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<HTML>
<HEAD>
<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">
<TITLE>&#160;</TITLE>
<META HTTP-EQUIV="Content-Style-Type" CONTENT="text/css">
<STYLE type="text/css">
HTML, BODY {
  background-color: #FFFFFF;
  color: #000000;
  margin: 0;
  padding: 0;
  /*text-align: center;*/
  font-family: Tahoma, Arial, Helvetica, sans-serif;
  font-size: 12px;
  height: 100%;
}
.layout {
  min-height:100%;
  position:relative;
}
* html .layout {height: 100%;}
.container {
  clear: both;
  width: 90%;
  margin: auto;
}
/* ********** ********** ********** HEADER AREA START ********** ********** ********** */
.logo {
  float: left;
  width: 250px;
  height: 80px;
}
.hdr {
  margin-left: 250px;
  height: 80px;
  overflow: auto;

  /*background-color: #EEEEEE;*/
}
* html .hdr {margin-bottom: -2px;}
/* ********** ********** ********** HEADER AREA END ********** ********** ********** */
/* ********** ********** ********** CONTENT AREA START ********** ********** ********** */
.cleft {
  float: left;
  width: 210px;
  border-top: 2px solid #000000;
  padding: 5px 5px 5px 5px;
  overflow: auto;
}
* html .cleft {width: 220px;}
.cright {
  float: right;
  width: 210px;
  border-top: 2px solid #000000;
  padding: 5px 5px 5px 5px;
  overflow: auto;
}
* html .cright {width: 220px;}
.ccont {
  margin-left: 220px; 
  margin-right: 220px; 
  border-left: 2px solid #000000;
  border-right: 2px solid #000000;
}
.cnt {
  margin-left: 10px; 
  margin-right: 10px;
  /*text-align: left;*/
  border-left: 2px solid #000000;
  border-right: 2px solid #000000;
  padding: 10px 10px 10px 10px;
  /*min-height: 450px;*/
  min-height: 250px;
  overflow: auto;
}
* html .cnt {height: 250px; margin-left: 7px; margin-right: 7px;}
.cnt_top {
    width: 50%;
    height: 2px;
    margin-left: 10px;
}
* html .cnt_top {display: block; margin-left: 7px;}
.cnt_bottom {
    width: 50%;
    height: 2px;
    margin-right: 10px;
}
* html .cnt_bottom {display: block; margin-right: 10px;}
/* ********** ********** ********** CONTENT AREA END ********** ********** ********** */
/* ********** ********** ********** FOOTER AREA START ********** ********** ********** */
.footer {
  width: 100%;
  padding: 10px 0px 10px 0px;
  font-size: 0.9em;
  /*text-align: center;*/
  position: absolute;
  bottom: 0;
  /*overflow: auto;*/
  background-color: #EEEEEE;
}
/* ********** ********** ********** FOOTER AREA END ********** ********** ********** */
</STYLE>
</HEAD>
<BODY>

<DIV CLASS="layout">
  <DIV CLASS="container">
    <DIV CLASS="logo">
      <IMG SRC="logo.gif" ALT="">
    </DIV>
    <DIV CLASS="hdr">
      header
    </DIV>
  </DIV>
  
  <DIV CLASS="container">
    <DIV CLASS="cleft">
      left side content
    </DIV>
    <DIV CLASS="cright">
      right side content
      <DIV STYLE="
      border: 1px solid #333333;
      padding: 5px 5px 5px 5px;
      margin-top: 5px;
      
      ">
      module<BR>
      module<BR>
      module<BR>
      module<BR>
      </DIV>
    </DIV>
    <DIV CLASS="ccont">
      <DIV ALIGN="left"><IMG CLASS="cnt_top" SRC="dot.png"  ALT=""></DIV>
      <DIV CLASS="cnt">
        main content
      </DIV>
      <DIV ALIGN="right"><IMG CLASS="cnt_bottom" SRC="dot.png" ALT=""></DIV>
    </DIV>
  </DIV>

  <DIV CLASS="footer">
     footer Copyright.. Link. Text etc etc
  </DIV>
</DIV>
</BODY>
</HTML>
<!--
if there is an adjacent float IE adds 3px;!
http://www.positioniseverything.net/explorer/threepxtest.html
-->